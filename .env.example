# Firebase web app config. These identify the project to the browser; they
# are not secrets (access is controlled by Firebase Auth's authorised domains).
# Copy to .env.local and fill in, or leave unset to run with guest play only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA v3 site key for Firebase App Check (bot protection).
VITE_FIREBASE_APPCHECK_SITE_KEY=
